# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Local SQLite database files (auto-created at runtime)
.data/
**/.data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment & credentials
.env
.env.local
.env.production
*.env

# Keep .env.example tracked — it documents required variables
!**/.env.example

# Binary / media files that don't belong in git
*.zip
*.dll
*.jpeg
*.jpg
*.gif
*.mp4
*.wav
*.mp3
*.webp

# Root-level dev screenshots and build artifacts
*.png
!artifacts/**/public/**/*.png
!reference/**/*.png

# Replit-specific config files
.replit
.replitignore
.replit-artifact/
.agents/
.conversation/

# WhatsApp and other personal media
WhatsApp Image*

# Root-level dev artifacts (actual copies live in artifacts/metrology-assistant/src/styles/)
theme-gov.css
tokens.css
